[gd_resource type="Resource" script_class="SignalDefinition" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/systems/satellite/signal_definition.gd" id="1_sigdef"]

[resource]
script = ExtResource("1_sigdef")
id = &"solar_flux_alert"
display_name = "Solar flux alert"
signal_type = &"alert"
channel = &"radiation"
description = "The sun is doing something. Panels should be stowed."
details = {
&"Dose rate": "12.0 mSv/h",
&"Source": "geomagnetic"
}
